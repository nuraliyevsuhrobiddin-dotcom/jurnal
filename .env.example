NEXT_PUBLIC_SITE_URL=https://agmjoural.uz
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Set a long, unique password in your private .env.local and hosting settings.
ADMIN_PASSWORD=
# Required together for Supabase storage; never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: persistent directory for a single self-hosted server without Supabase.
# JOURNAL_DATA_DIR=
# Standalone reverse proxy only: set true only if it REPLACES X-Real-IP.
# Vercel uses its own trusted forwarding header automatically.
TRUST_PROXY_IP=false
# Email provider: resend (default) or gmail. See docs/publication-email.md.
MAIL_PROVIDER=resend
# Resend: verify MAIL_FROM's domain first.
RESEND_API_KEY=
MAIL_FROM=
# Gmail: authorize the journal account with gmail.send and offline access.
# Store secrets only in .env.local and hosting environment variables.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Google Search Console HTML verification token (not a Google API key).
GOOGLE_SITE_VERIFICATION=
# Scheduler: invoke GET /api/cron/notifications with Authorization: Bearer <secret>.
CRON_SECRET=
# Stable private signing key for 180-day manuscript tracking links.
# ADMIN_PASSWORD is the fallback; rotate deliberately to invalidate old links.
TRACKING_SECRET=
# External publishing stays in test/sandbox until deliberately enabled.
INTEGRATION_PRODUCTION_ENABLED=false
CROSSREF_MODE=test
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
ZENODO_MODE=sandbox
ZENODO_ACCESS_TOKEN=
ORCID_MODE=sandbox
# Enables real ORCID sign-in without enabling Crossref/Zenodo production deposits.
ORCID_PRODUCTION_ENABLED=false
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Optional independent cookie signing secret; ADMIN_PASSWORD is used if omitted.
ORCID_COOKIE_SECRET=
# Disable only after the named owner account and authenticator have been verified.
LEGACY_ADMIN_LOGIN=true
# Register NEXT_PUBLIC_SITE_URL + /api/orcid/callback in your ORCID application.
